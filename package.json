{
  "name": "fbx2vrma-app",
  "version": "0.1.0",
  "private": true,
  "description": "Web app for converting FBX animation files to VRMA and previewing them with a VRM model.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "api": "node server/index.cjs",
    "start": "node server/index.cjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "setup": "npm --prefix fbx2vrma-converter run setup",
    "test": "npm --prefix fbx2vrma-converter test && npm run build"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.3",
    "@pixiv/three-vrm-animation": "^3.5.3",
    "@vitejs/plugin-react": "^6.0.2",
    "archiver": "^7.0.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fbx2vrma-converter": "file:./fbx2vrma-converter",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "multer": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.184.0",
    "vite": "^8.0.16"
  }
}
